function tbl = cleanTableHeaders(tbl)
    rawNames = tbl.Properties.VariableNames;
    cleanNames = cell(size(rawNames));
    for i = 1:length(rawNames)
        str = rawNames{i};
        
        str = regexprep(str, '[^a-zA-Z0-9]', '');
        
        cleanNames{i} = str;
    end
    tbl.Properties.VariableNames = cleanNames;
end


function val = getVal(tbl, rowIdx, keywords)
    val = 0;
    varNames = tbl.Properties.VariableNames;
    
    
    for k = 1:length(keywords)
        for v = 1:length(varNames)
            if contains(lower(varNames{v}), lower(keywords{k}))
                val = tbl{rowIdx, v};
                if isnumeric(val) && ~isnan(val)
                    return; 
                end
            end
        end
    end
end


function scores = scoreComponent(tbl)
    numRows = height(tbl);
    varNames = tbl.Properties.VariableNames;
    normMatrix = zeros(numRows, 0);
    
    
    negKeywords = {'cost', 'degradation', 'fade', 'maintenance', 'heat', 'carbon', 'water'};
    
 
    for c = 2:length(varNames)
        colName = varNames{c};
        vals = tbl{:, c};
        
        if isnumeric(vals)
            minVal = min(vals);
            maxVal = max(vals);
            
            
            isNegative = false;
            for k = 1:length(negKeywords)
                if contains(lower(colName), negKeywords{k})
                    isNegative = true;
                    break;
                end
            end
            
            if maxVal == minVal
                normVals = ones(numRows, 1);
            else
                
                if isNegative
                    
                    normVals = (maxVal - vals) / (maxVal - minVal);
                else
                    
                    normVals = (vals - minVal) / (maxVal - minVal);
                end
            end
            normMatrix = [normMatrix, normVals]; 
        end
    end
    
    scores = mean(normMatrix, 2);
end
